{
  "expo": {
    "name": "English Tutor",
    "slug": "emmaline",
    "owner": "freesurf",
    "version": "0.3.2",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/app-icon-dark-1024.png",
      "bundleIdentifier": "tools.freesurf.tutor",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "English Tutor",
        "NSMicrophoneUsageDescription": "FreeSurf English Tutor uses your microphone to record your speaking practice so the AI tutor can listen, correct your grammar and pronunciation, and respond. Audio is processed to generate the response and is not stored.",
        "NSUserTrackingUsageDescription": "Your device identifier is used to serve personalized ads and keep FreeSurf free.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "splash": {
      "image": "./assets/app-icon-dark-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-dark-1024.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ],
      "package": "tools.freesurf.tutor"
    },
    "plugins": [
      "expo-secure-store",
      "expo-tracking-transparency",
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.0" }, "android": { "compileSdkVersion": 36, "targetSdkVersion": 36, "buildToolsVersion": "36.0.0" } }]
    ],
    "extra": {
      "eas": {
        "projectId": "fc34b757-3492-45c6-8517-ed22abab10a1"
      }
    }
  }
}
